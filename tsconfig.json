{
    "compilerOptions": {
        "target": "es2022",
        "module": "commonjs",
        "lib": ["es2022", "DOM"],
        "rootDir": "./src",
        "outDir": "dist",
        "sourceMap": true,
        "allowJs": true,
        "forceConsistentCasingInFileNames": true,
        "noImplicitReturns": true,
        "noImplicitThis": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "skipLibCheck": true,
        "experimentalDecorators": true,
        "noUnusedLocals": false,
        "esModuleInterop": true,
        "jsx": "react"
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
