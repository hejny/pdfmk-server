# ==============================================================================
# PDF Maker - Local Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.template .env
# ==============================================================================

# Application environment (development | production)
NODE_ENV=development

# Base URL where the PDF maker service is hosted
# Used by the interactive form UI at / to submit requests to /make
SELF_URL=http://localhost:8080/

# Optional: Comma-separated list of allowed domains for PDF/screenshot rendering
# Example: ALLOWED_DOMAINS=example.com,mydomain.org
ALLOWED_DOMAINS=

# Optional: Custom Puppeteer launch options in JSON format
# Default: {"args":["--no-sandbox","--disable-setuid-sandbox","--disable-dev-shm-usage"]}
# PUPPETEER_LAUNCH_OPTIONS={"args":["--no-sandbox","--disable-setuid-sandbox","--disable-dev-shm-usage"]}

# Optional: Fallback PDF options in JSON format (format, margins, background)
# PUPPETEER_PDF_OPTIONS={"format":"A4","printBackground":true,"margin":{"left":"1cm","top":"1cm","right":"1cm","bottom":"1cm"}}
