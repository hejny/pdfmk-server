# ==============================================================================
# Google Cloud Functions Environment Variables (YAML format)
# Used during deployment via: --env-vars-file=.env.gcloud
# ==============================================================================

NODE_ENV: "production"

# Base URL of your deployed Cloud Function.
# Used by the interactive form at / to target /make.
# Replace europe-west3 and YOUR_PROJECT_ID with your actual region and GCP project ID.
SELF_URL: "https://europe-west3-{PROJECT_ID}.cloudfunctions.net/pdfmaker"

# Optional: Comma-separated list of allowed domains for PDF/screenshot rendering
ALLOWED_DOMAINS: ""

# Puppeteer launch arguments for headless Chromium in cloud container environments
PUPPETEER_LAUNCH_OPTIONS: '{ "headless": true, "args": ["--no-sandbox"], "cacheDirectory": "/workspace/.cache/puppeteer" }'
